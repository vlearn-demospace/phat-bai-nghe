// Phát bài nghe – bản dịch vụ trên Cloudflare (Workers + D1 + R2 + Durable Objects).
// Tài khoản thử: KHÔNG dùng tài khoản đang chạy lvcnghe.pages.dev.
{
  "name": "phat-bai-nghe",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "d1_databases": [{ "binding": "DB", "database_name": "phat-bai-nghe", "database_id": "0bfedba5-71b7-4970-a104-642ef87436ea", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "phat-bai-nghe" }],
  "durable_objects": { "bindings": [{ "name": "TRUONG", "class_name": "Truong" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Truong"] }],
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false
  // Bí mật (wrangler secret put): MASTER_KEY (32 byte base64), SUPER_TOKEN (mã siêu admin)
}
